FROM python:3.12-slim AS build
RUN python -m venv /venv
COPY requirements.txt .
COPY wheels/ /wheels/
# wheels/ is pre-downloaded on the host (office network blocks DNS inside builds)
RUN /venv/bin/pip install --no-cache-dir --no-index --find-links /wheels -r requirements.txt

FROM python:3.12-slim
RUN useradd --system --uid 10001 app
COPY --from=build /venv /venv
WORKDIR /app
COPY app.py .
USER app
ENV NOTES_DB=/tmp/notes.db PYTHONDONTWRITEBYTECODE=1
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=3s CMD ["/venv/bin/python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health')"]
CMD ["/venv/bin/gunicorn", "--bind", "0.0.0.0:8000", "app:app"]
